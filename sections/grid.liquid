<div class="custom-grid-section">
    <h2 class="custom-grid-heading">{{ section.settings.heading }}</h2>
    <div class="custom-grid">
      {% for block in section.blocks %}
      <div data-index="{{ forloop.index0 }}">
        <img
          src="{{ block.settings.image | image_url: width: 600 }}"
          alt="{{ block.settings.title }}"
          class="custom-grid-img"
        />
      </div>
      {% endfor %}
    </div>
    <div class="custom-grid-modal" id="customGridModal" style="display: none">
      <div class="custom-grid-modal-content">
        <span class="custom-grid-modal-close" id="customGridModalClose"
          >&times;</span
        >
        <div class="custom-grid-modal-row">
          <img id="modalImg" src="" alt="" class="custom-grid-modal-img" />
          <div class="custom-grid-modal-info">
            <h3 id="modalTitle"></h3>
            <div id="modalPrice" class="custom-grid-modal-price"></div>
            <p id="modalDesc"></p>
          </div>
        </div>
        <div class="custom-grid-modal-row custom-grid-modal-colors">
          <span class="custom-grid-modal-label">Color:</span>
          <span id="colorBox1" class="color-box"></span>
          <span id="colorBox2" class="color-box"></span>
        </div>
        <div class="custom-grid-modal-row">
          <label for="modalSize">Size:</label>
          <br />
          <div class="custom-grid-modal-size-select">
            <select id="modalSize">
              <option value="" disabled selected>Choose your size</option>
              <option>XS</option>
              <option>S</option>
              <option>M</option>
              <option>L</option>
              <option>XL</option>
            </select>
            <span class="custom-grid-modal-arrow">&#9662;</span>
          </div>
        </div>
        <div class="custom-grid-modal-row">
          <button id="modalAddToCart" class="custom-grid-add-to-cart">
            Add to Cart &rarr;
          </button>
        </div>
      </div>
    </div>
  
    <style>
      .custom-grid-section {
        max-width: 1200px;
        margin: 0 auto;
        padding: 32px 16px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
      }
      .custom-grid-heading {
        text-align: center;
        margin-bottom: 32px;
      }
      .custom-grid {
        flex: 1 1 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        align-items: start; /* Add this line */
      }
  
      @media (max-width: 767px) {
        .custom-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 8px;
        }
      }
      .custom-grid-item {
        margin: 0;
        padding: 0;
        height: auto;
      }
      .custom-grid-img {
        width: 100%;
        height: auto;
        object-fit: contain;
        border-radius: 6px;
        display: block;
        max-height: 180px;
        margin: 0;
        padding: 0;
      }
      @media (max-width: 767px) {
        .custom-grid-img {
          height: 100%;
        }
      }
  
      /* Modal Overlay */
      .custom-grid-modal {
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: none; /* Hidden by default, shown with JS */
        align-items: center;
        justify-content: center;
      }
      .custom-grid-modal[style*="display: flex"] {
        display: flex !important;
      }
      .custom-grid-modal-content {
        background: #fff;
        padding: 32px 24px;
        border-radius: 10px;
        max-width: 480px;
        width: 95vw;
        position: relative;
        text-align: left;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
        animation: modal-pop 0.25s cubic-bezier(0.4, 2, 0.6, 1) both;
      }
      @keyframes modal-pop {
        0% {
          transform: scale(0.95);
          opacity: 0;
        }
        100% {
          transform: scale(1);
          opacity: 1;
        }
      }
      .custom-grid-modal-close {
        position: absolute;
        top: 12px;
        right: 16px;
        font-size: 2em;
        cursor: pointer;
        color: #888;
        transition: color 0.2s;
      }
      .custom-grid-modal-close:hover {
        color: #111;
      }
      .custom-grid-modal-row {
        display: flex;
        align-items: center;
        margin-bottom: 18px;
      }
      .custom-grid-modal-img {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: 6px;
        margin-right: 18px;
        background: #f5f5f5;
      }
      .custom-grid-modal-info {
        flex: 1;
      }
      .custom-grid-modal-price {
        font-weight: bold;
        margin: 8px 0;
      }
      .custom-grid-modal-colors {
        justify-content: flex-start;
        gap: 16px;
      }
      .color-box {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        border: 2px solid #ccc;
        display: inline-block;
        cursor: pointer;
        transition:
          background 0.3s,
          border 0.3s,
          box-shadow 0.3s,
          color 0.3s;
        box-shadow: 0 0 0 0 #000;
        margin-right: 8px;
        text-align: center;
        line-height: 36px;
        font-weight: bold;
        color: #222;
        background: #f5f5f5;
        user-select: none;
      }
      .color-box.selected {
        background: #111;
        color: #fff;
        border: 2px solid #111;
        box-shadow: 0 0 8px 2px #1112;
      }
      .custom-grid-modal-row label {
        margin-right: 8px;
      }
      .custom-grid-add-to-cart {
        width: 100%;
        padding: 12px 0;
        background: #111;
        color: #fff;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 1.1em;
        font-weight: bold;
        transition: background 0.2s;
      }
      .custom-grid-add-to-cart:hover {
        background: #222;
      }
  
      .color-box {
        width: 110px;
        height: 40px;
        border-radius: 0; /* No round corners */
        border: 2px solid #ccc;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition:
          background 0.3s,
          border 0.3s,
          color 0.3s;
        margin-right: 0;
        text-align: center;
        font-weight: bold;
        color: #111;
        background: #fff;
        user-select: none;
        font-size: 1em;
        margin-left: 0;
      }
      .color-box.selected {
        background: #111;
        color: #fff;
        border: 2px solid #111;
      }
      .color-box:not(.selected) {
        background: #fff;
        color: #111;
        border: 2px solid #ccc;
      }
      .color-box + .color-box {
        margin-left: 0;
      }
      .custom-grid-modal-colors {
        gap: 0 !important;
      }
      .custom-grid-modal-label {
        color: #888;
        font-size: 1em;
        min-width: 60px;
        margin-right: 12px;
        font-weight: 500;
        display: inline-block;
      }
      .custom-grid-modal-colors {
        gap: 0 !important;
      }
      .custom-grid-modal-size-select {
        position: relative;
        flex: 1;
        display: flex;
        align-items: center;
      }
      #modalSize {
        width: 100%;
        padding: 10px 36px 10px 12px;
        font-size: 1em;
        border: 2px solid #ccc;
        border-radius: 6px;
        appearance: none;
        background: #fafafa;
        color: #222;
        font-weight: 500;
      }
      .custom-grid-modal-arrow {
        position: absolute;
        right: 12px;
        pointer-events: none;
        color: #888;
        font-size: 1.2em;
      }
    </style>
  
<script>
    var cart = [];
    
    document.addEventListener('DOMContentLoaded', function() {
        var items = document.querySelectorAll('.custom-grid > div');
        var modal = document.getElementById('customGridModal');
        var closeBtn = document.getElementById('customGridModalClose');
        var modalImg = document.getElementById('modalImg');
        var modalTitle = document.getElementById('modalTitle');
        var modalDesc = document.getElementById('modalDesc');
        var modalPrice = document.getElementById('modalPrice');
        var modalColor1 = document.getElementById('colorBox1');
        var modalColor2 = document.getElementById('colorBox2');
        var modalSize = document.getElementById('modalSize');
        var addToCartBtn = document.getElementById('modalAddToCart');
    
        // Data for modal (from blocks)
        var gridData = [
        {% for block in section.blocks %}
            {
            img: "{{ block.settings.image | image_url: width: 600 }}",
            title: "{{ block.settings.title | escape }}",
            desc: "{{ block.settings.description | escape }}",
            price: "{{ block.settings.price | escape }}",
            color1: "{{ block.settings.color1 | escape }}",
            color2: "{{ block.settings.color2 | escape }}"
            }{% unless forloop.last %},{% endunless %}
        {% endfor %}
        ];
    
        var selectedColor = 0;
    
        items.forEach(function(item, idx) {
        item.addEventListener('click', function() {
            var data = gridData[idx];
            modalImg.src = data.img;
            modalTitle.textContent = data.title;
            modalDesc.textContent = data.desc;
            modalPrice.textContent = data.price;
    
            // Color boxes
            modalColor1.textContent = data.color1 || '';
            modalColor2.textContent = data.color2 || '';
    
            // Set initial backgrounds: first 10% is color, rest is black (selected) or white (unselected)
            modalColor1.style.background = `linear-gradient(to right, ${data.color1 || '#fff'} 0 10%, #111 10% 100%)`;
            modalColor2.style.background = `linear-gradient(to right, ${data.color2 || '#fff'} 0 10%, #fff 10% 100%)`;
            modalColor1.style.color = '#fff';
            modalColor2.style.color = '#111';
    
            modalColor1.classList.add('selected');
            modalColor2.classList.remove('selected');
            selectedColor = 0;
            modal.style.display = 'flex';
        });
        });
    
        function selectColor(idx) {
        if(idx === 0) {
            modalColor1.classList.add('selected');
            modalColor2.classList.remove('selected');
        } else {
            modalColor2.classList.add('selected');
            modalColor1.classList.remove('selected');
        }
        // Update backgrounds after selection
        modalColor1.style.background = `linear-gradient(to right, ${modalColor1.textContent || '#fff'} 0 10%, ${modalColor1.classList.contains('selected') ? '#111' : '#fff'} 10% 100%)`;
        modalColor2.style.background = `linear-gradient(to right, ${modalColor2.textContent || '#fff'} 0 10%, ${modalColor2.classList.contains('selected') ? '#111' : '#fff'} 10% 100%)`;
        modalColor1.style.color = modalColor1.classList.contains('selected') ? '#fff' : '#111';
        modalColor2.style.color = modalColor2.classList.contains('selected') ? '#fff' : '#111';
        selectedColor = idx;
        }
    
        modalColor1.addEventListener('click', function() { selectColor(0); });
        modalColor2.addEventListener('click', function() { selectColor(1); });
    
        closeBtn.addEventListener('click', function() {
        modal.style.display = 'none';
        });
    
        modal.addEventListener('click', function(e) {
        if(e.target === modal) modal.style.display = 'none';
        });
    
        addToCartBtn.addEventListener('click', function() {
        // Find the current product index
        var productIdx = Array.from(items).findIndex(item => item.querySelector('img').src === modalImg.src);
        var product = gridData[productIdx];
        var selectedColorValue = modalColor1.classList.contains('selected') ? product.color1 : product.color2;
        var selectedSize = modalSize.value;
    
        var cartItem = {
            title: product.title,
            color: selectedColorValue,
            size: selectedSize
        };
        cart.push(cartItem);
    
        // Bonus: If Black and Medium, add "Soft Winter Jacket"
        if (selectedColorValue && selectedColorValue.toLowerCase() === 'black' && selectedSize && selectedSize.toLowerCase() === 'm') {
            var bonusProduct = gridData.find(p => p.title.trim().toLowerCase() === 'soft winter jacket');
            if (bonusProduct) {
            cart.push({
                title: bonusProduct.title,
                color: bonusProduct.color1 || '',
                size: 'M'
            });
            }
        }
        // Log cart contents
        console.log('Cart:', cart);
        });
    
    });
    </script>

{% schema %}
{
  "name": "Custom Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Grid Heading",
      "default": "Our Featured Products"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Grid Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "price", "label": "Price" },
        { "type": "text", "id": "color1", "label": "Color Option 1" },
        { "type": "text", "id": "color2", "label": "Color Option 2" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Custom Grid",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
